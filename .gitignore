# Never commit source PDFs, archives or credentials
*.pdf
*.zip
# .env is tracked: it holds ONLY public browser config (Supabase URL + publishable key).
# Hosted builds read it; ignoring it broke sign-in. Secrets never go in any env file here.
.env.*
!.env.example

# Netlify build output
.netlify/

# Local Supabase CLI cache
supabase/.temp/
